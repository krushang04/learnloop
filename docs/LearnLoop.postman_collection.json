            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestampSeconds\": 8,\n  \"type\": \"single_choice\",\n  \"prompt\": \"What does an HS code identify?\",\n  \"options\": [\n    {\n      \"key\": \"a\",\n      \"text\": \"A traded product\"\n    },\n    {\n      \"key\": \"b\",\n      \"text\": \"A shipping container\"\n    }\n  ],\n  \"correctOptionKeys\": [\n    \"a\"\n  ],\n  \"points\": 2,\n  \"explanation\": \"HS codes classify products.\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Add multiple choice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/videos/{{videoId}}/questions",
              "host": [
