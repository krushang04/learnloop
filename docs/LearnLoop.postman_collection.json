            "description": "Needs at least two correct options, otherwise use single_choice.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestampSeconds\": 16,\n  \"type\": \"multiple_choice\",\n  \"prompt\": \"Which are consequences of misclassification?\",\n  \"options\": [\n    {\n      \"key\": \"a\",\n      \"text\": \"Duty errors\"\n    },\n    {\n      \"key\": \"b\",\n      \"text\": \"Border delays\"\n    },\n    {\n      \"key\": \"c\",\n      \"text\": \"Cheaper fuel\"\n    }\n  ],\n  \"correctOptionKeys\": [\n    \"a\",\n    \"b\"\n  ],\n  \"points\": 3\n}"
            }
          },
          "response": []
