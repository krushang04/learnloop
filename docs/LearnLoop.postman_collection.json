{
  "info": {
    "name": "LearnLoop API",
    "description": "Video Learning + Interactive Quiz Builder.\n\nRun **Auth \u2192 Login as admin** and **Login as learner** first; both save their token into the collection variables used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "learnerToken",
      "value": ""
    },
    {
      "key": "videoId",
      "value": ""
    },
    {
      "key": "questionId",
      "value": ""
    },
    {
      "key": "learnerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Saves the returned token into {{adminToken}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@learnloop.dev\",\n  \"password\": \"Admin@123\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.collectionVariables.set('adminToken', body.data.accessToken);",
                  "  pm.test('admin token saved', () => pm.expect(body.data.user.role).to.eql('admin'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as learner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Saves the returned token into {{learnerToken}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha@learnloop.dev\",\n  \"password\": \"Learner@123\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.collectionVariables.set('learnerToken', body.data.accessToken);",
                  "  pm.test('learner token saved', () => pm.expect(body.data.user.role).to.eql('learner'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (learner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Self-service signup. Always creates a learner, never an admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Learner\",\n  \"email\": \"new.learner@learnloop.dev\",\n  \"password\": \"Learner@123\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Current user; used by the SPA to rehydrate a session on refresh."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Videos (Admin)",
      "item": [
        {
          "name": "List videos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/videos?search=&status=published&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "videos"
              ],
              "query": [
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": "published"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Supports search, status, tag and pagination."
          },
          "response": []
        },
        {
          "name": "Create video",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/videos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "videos"
              ]
            },
            "description": "Copy the returned _id into the {{videoId}} collection variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction to Incoterms\",\n  \"description\": \"A short primer.\",\n  \"videoUrl\": \"https://download.samplelib.com/mp4/sample-30s.mp4\",\n  \"thumbnailUrl\": \"https://picsum.photos/seed/incoterms/640/360\",\n  \"durationSeconds\": 30,\n  \"tags\": [\n    \"logistics\"\n  ]\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get video (with questions + answers)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/videos/{{videoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "videos",
                "{{videoId}}"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Update video",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/videos/{{videoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "videos",
                "{{videoId}}"
              ]
            },
            "description": "Shortening the duration past an existing question timestamp is rejected with 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction to Incoterms (v2)\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Publish video",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/videos/{{videoId}}/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "videos",
                "{{videoId}}",
                "publish"
              ]
            },
            "description": "Rejected with 400 if the duration is unset or a question has no correct answer."
          },
          "response": []
        },
        {
          "name": "Unpublish video",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/videos/{{videoId}}/unpublish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "videos",
                "{{videoId}}",
                "unpublish"
              ]
            },
            "description": "Hides it from learners; assignments and progress are retained."
          },
          "response": []
        },
        {
          "name": "Delete video",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/videos/{{videoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "videos",
                "{{videoId}}"
              ]
            },
            "description": "Cascades to questions, assignments, progress and responses."
          },
          "response": []
        }
      ]
    },
